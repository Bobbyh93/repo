    "include_remediation_plan": true,
    "include_qa_log": true,
    "target_duration_minutes": "{{outputs.target_duration_minutes}}"
  },
  "layout": {
    "theme_id": "{{layout.theme_id}}",
    "pptx_template_path": "{{layout.pptx_template_path}}",
    "archetype_set": [
      "title",
      "opening_case",
      "clinical_question",
      "chapter_map",
      "warmup_sequence",
      "concept_cards",
      "match_activity",
      "debrief",
      "timeline",
      "checkpoint_mcq",
      "mini_case",
      "urgency_sort",
      "capstone_mcq",
      "retrieval_check",
      "takeaway"
    ],
    "allow_overlap": false,
    "safe_regions": {}
  },
  "media": {
    "voice_id": "{{media.voice_id}}",
    "wpm_target": 140,
    "audio_format": "mp3",
    "auto_advance_strategy": "duration_plus_buffer"
  },
  "qa": {
    "required_gates": [
      "runtime",
      "source",
      "taxonomy",
      "blueprint",
      "cjm_coverage",
      "outline",
      "script",
      "timing",
      "layout",
      "deck_render",
      "package_manifest"
    ],
    "blocker_rules": [
      "missing required runtime variables",
      "unsupported clinical claims labeled as source-grounded",
      "duplicate slide ids",
      "missing cjm coverage without documented rationale",
      "claimed files not created"
    ],
    "release_status_allowed": [
      "release-ready",
      "faculty-review-needed",
      "draft-only",
      "blocked"
    ]
  },
  "revision": {
    "prior_package_id": "{{revision.prior_package_id}}",
    "target_slide_ids": [],
    "change_request": "{{revision.change_request}}",
    "dependency_impact": []
  },
  "unresolved_variables": []
