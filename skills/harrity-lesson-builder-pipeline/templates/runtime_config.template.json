  "outputs": {
    "target_outputs": [
      "lesson_deck.pptx",
      "facilitator_guide.md",
      "learner_handout.md",
      "assessment_map.csv",
      "lesson_manifest.json"
    ],
    "max_slides_per_deck": 45,
    "target_slide_count": "{{outputs.target_slide_count}}",
    "include_learner_deck": true,
    "include_faculty_deck": true,
    "include_speaker_notes": true,
    "include_tts_text": false,
    "include_audio_package": false,
    "include_binding_manifest": false,
