{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harrity.example/schemas/master-lesson-1.0.0.json",
  "title": "Harrity Master Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_type",
    "promotion_state",
    "administrative_metadata",
    "source_governance",
    "taxonomy_lock",
    "learning_outcomes",
    "lesson_design",
    "assessment_plan",
    "media_binding",
    "quality_assurance",
    "approvals",
    "release_metadata"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_type": {"const": "harrity_master_lesson"},
    "promotion_state": {
      "enum": ["template", "intake_complete", "faculty_review", "production_ready", "release_ready", "released"]
    },
    "administrative_metadata": {
      "type": "object",
      "required": ["lesson_id", "course_id", "course_name", "program_level", "lesson_title", "version", "content_owner", "faculty_reviewer", "created_date", "target_release_date"],
      "properties": {
        "lesson_id": {"type": "string", "pattern": "^LESSON-[A-Z0-9-]+$"},
        "course_id": {"type": "string", "minLength": 1},
        "course_name": {"type": "string", "minLength": 1},
        "program_level": {"type": "string", "minLength": 1},
        "lesson_title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "content_owner": {"type": "string", "minLength": 1},
        "faculty_reviewer": {"type": "string", "minLength": 1},
        "created_date": {"type": "string", "format": "date"},
        "target_release_date": {"type": "string", "minLength": 1}
      }
    },
    "source_governance": {
      "type": "object",
      "required": ["approval_status", "coverage_status", "organizing_clinical_question", "sources"],
      "properties": {
        "approval_status": {"enum": ["unapproved", "approved"]},
        "coverage_status": {"enum": ["absent", "partial", "complete"]},
        "organizing_clinical_question": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "taxonomy_lock": {
      "type": "object",
      "required": ["status", "concept", "nclex_client_need", "body_system", "priority_framework", "bloom_levels", "qsen_domains", "aacn_competencies", "ncjmm_functions", "approved_by", "approval_date"],
      "properties": {
        "status": {"enum": ["unlocked", "locked"]},
        "ncjmm_functions": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 6,
          "items": {"enum": ["recognize_cues", "analyze_cues", "prioritize_hypotheses", "generate_solutions", "take_action", "evaluate_outcomes"]}
        }
      }
    },
    "learning_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["objective_id", "statement", "bloom_level", "nclex_alignment", "aacn_alignment", "qsen_alignment", "assessment_method", "approval_status"],
        "properties": {
          "objective_id": {"type": "string", "pattern": "^LO-[0-9]{2}$"},
          "approval_status": {"enum": ["draft", "approved"]}
        }
      }
    },
    "lesson_design": {
      "type": "object",
      "required": ["estimated_minutes", "audience_prerequisites", "glossary", "slides", "required_slide_types"],
      "properties": {
        "estimated_minutes": {"type": "number", "minimum": 0},
        "slides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["slide_id", "slide_type", "title", "learner_facing_content", "objective_ids", "reference_ids", "speaker_notes", "tts_text", "estimated_seconds", "layout_instruction", "media", "accessibility", "approval_status"],
            "properties": {
              "slide_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
              "estimated_seconds": {"type": "number", "minimum": 0},
              "approval_status": {"enum": ["draft", "approved"]}
            }
          }
        }
      }
    },
    "assessment_plan": {"type": "object"},
    "media_binding": {"type": "object"},
    "quality_assurance": {"type": "object"},
    "approvals": {"type": "object"},
    "release_metadata": {"type": "object"}
  }
}
