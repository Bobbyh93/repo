  "taxonomy": {
    "glossary": [
      {
        "term": "perfusion",
        "definition": "Delivery of oxygenated blood to tissue; its failure is reported by several organ systems at once.",
        "source_ref": "SRC02"
      },
      {
        "term": "altered mentation",
        "definition": "New confusion or reduced responsiveness compared with the patient's earlier state.",
        "source_ref": "SRC02"
      },
      {
        "term": "new organ dysfunction",
        "definition": "A perfusion-related change in an organ system that differs from this patient's own baseline.",
        "source_ref": "SRC02"
      },
      {
        "term": "escalation",
        "definition": "Activating the organisation's sepsis or rapid-response pathway, communicating trend and suspected source, obtaining ordered diagnostics, and beginning stabilization.",
        "source_ref": "SRC02"
      },
      {
        "term": "parallel action",
        "definition": "Coordinating diagnostics, treatment and stabilization together rather than waiting for one step to finish.",
        "source_ref": "SRC02"
      }
