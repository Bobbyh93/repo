  "taxonomy": {
    "glossary": [
      {
        "term": "family dynamics",
        "definition": "Roles, relationships, communication patterns, and factors shaping how family members interact.",
        "source_ref": "SRC01"
      },
      {
        "term": "family dysfunction",
        "definition": "Failure of the five family functions; usually unintended; transmitted across generations.",
        "source_ref": "SRC01"
      },
      {
        "term": "adverse childhood experiences (ACE)",
        "definition": "Neglect, abuse, divorce, incarceration of a family member, witnessing substance abuse, mental illness, or violence against a parent.",
        "source_ref": "SRC01"
      },
      {
        "term": "caregiver role strain",
        "definition": "Difficulty performing the family caregiver role.",
        "source_ref": "SRC01"
      },
      {
        "term": "family-centered care",
        "definition": "Client-centered approach emphasizing family involvement and collaboration in care and decisions.",
